{
  "manifest_version": 3,
  "name": "Split view test",
  "version": "0.1",
  "description": "Logs what the tabs API reports for tabs in split view or tab tiling.",
  "permissions": ["tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {},
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}

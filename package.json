{
  "name": "web-monetization-extension",
  "description": "Web Monetization is a browser API that allows the creation of a payment stream from the user agent to the website.",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/interledger/web-monetization-extension"
  },
  "scripts": {
    "build": "node ./scripts/build.ts",
    "dev": "node --watch ./scripts/build.ts --dev",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format && prettier . --check",
    "format:fix": "biome format --write && prettier . --write --log-level=warn",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:report": "playwright show-report tests/e2e/playwright-report",
    "test:e2e:wdio": "wdio run tests/wdio/wdio.conf.ts"
  },
  "dependencies": {
    "@interledger/open-payments": "^7.4.0",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "awilix": "^13.0.5",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.4.0",
    "http-message-signatures": "^1.0.6",
    "idb": "^8.0.4",
    "imd": "npm:@sidvishnoi/imd@^0.0.2",
    "iso8601-duration": "^2.2.0",
    "loglevel": "^1.9.2",
    "posthog-js": "1.417.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "structured-headers": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "valtio": "^2.3.2",
    "webextension-polyfill": "^0.12.0",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@octokit/openapi-webhooks-types": "^12.2.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/archiver": "^8.0.0",
    "@types/chrome": "^0.2.9",
    "@types/github-script": "github:actions/github-script#v9.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitest/coverage-v8": "^4.1.12",
    "@wdio/cli": "^10.2.0",
    "@wdio/globals": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "@wdio/spec-reporter": "^10.2.0",
    "archiver": "^8.0.0",
    "esbuild": "^0.28.2",
    "esbuild-node-builtin": "^0.1.1",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-style-plugin": "^1.6.3",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "sade": "^1.8.1",
    "tailwindcss": "^4.3.5",
    "tinyspy": "^4.0.6",
    "totp-generator": "^2.0.1",
    "typescript": "npm:typescript@^6.0.3",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.12",
    "webdriverio": "^10.2.0"
  },
  "engines": {
    "pnpm": "^11.9.0",
    "npm": "pnpm",
    "yarn": "pnpm",
    "node": "^24.22.1"
  },
  "type": "module",
  "packageManager": "pnpm@11.10.0"
}
